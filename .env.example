# Key names only, never values (SRD §3.4, §12).
# Abbas copies this file to .env and fills it in; Claude never reads .env.
# `uv run ce doctor` reports each key as set or missing without printing it.
# The tag after each name is the SRD §19 item that produces the key.

# G0.3 Anthropic Console key named content-engine
ANTHROPIC_API_KEY=
# G0.4 ElevenLabs key named content-engine (set a credit limit if offered)
ELEVENLABS_API_KEY=
# G0.5 HeyGen, optional: only if the plan includes API access
HEYGEN_API_KEY=
# G0.7 Postiz Cloud: Settings > Public API
POSTIZ_API_KEY=
# G0.9a Pexels free API key
PEXELS_API_KEY=
# Phase 2: trend radar
YOUTUBE_DATA_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
